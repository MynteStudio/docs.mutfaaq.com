{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "docs.mutfaaq.com",
  "description": "Step-by-step guides for Mutfaaq.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "en/introduction",
              "en/pricing-and-limits",
              "en/access-and-permissions"
            ]
          },
          {
            "group": "Menus",
            "icon": "book-open",
            "expanded": false,
            "pages": [
              "en/menus/overview",
              "en/menus/categories",
              "en/menus/products",
              "en/menus/options-and-extras",
              "en/menus/availability-and-stock"
            ]
          }
        ]
      },
      {
        "language": "fr",
        "groups": [
          {
            "group": "Bien démarrer",
            "icon": "rocket",
            "expanded": true,
            "pages": [
              "fr/introduction",
              "fr/tarifs-et-limites",
              "fr/acces-et-autorisations"
            ]
          },
          {
            "group": "Menus",
            "icon": "book-open",
            "expanded": false,
            "pages": [
              "fr/menus/vue-ensemble",
              "fr/menus/categories",
              "fr/menus/produits",
              "fr/menus/options-et-supplements",
              "fr/menus/disponibilite-et-stock"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mutfaaq.com/auth/login"
    }
  },
  "footer": {
    "socials": {
      "earth-americas": "https://mutfaaq.com"
    }
  }
}
