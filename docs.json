{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "docs.mutfaaq.com",
  "description": "Step-by-step guides for Mutfaaq.",
  "colors": {
    "primary": "#7C3AED",
    "light": "#A78BFA",
    "dark": "#6D28D9"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "languages": [
      {
        "language": "en",
        "default": true,
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "expanded": true,
            "pages": ["en/welcome"]
          }
        ]
      },
      {
        "language": "fr",
        "groups": [
          {
            "group": "Bien démarrer",
            "icon": "rocket",
            "expanded": true,
            "pages": ["fr/bienvenue"]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mutfaaq.com/auth/login"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  }
}
